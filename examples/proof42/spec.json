{
  "name": "proof-42-demo",
  "problem": "Search near x=42, form testable conjectures, then produce and independently verify a natural-language proof for a supported conjecture.",
  "domain": "generic",
  "mode": "hybrid",
  "objectives": [
    {"name": "distance_to_42", "direction": "minimize", "weight": 1.0}
  ],
  "constraints": [],
  "behavior_dimensions": ["representation"],
  "budget": {
    "generations": 1,
    "population_size": 1,
    "evaluator_timeout_seconds": 10,
    "seed": 11
  },
  "search": {
    "novelty_probability": 0.25,
    "novelty_k": 3,
    "migration_interval": 2,
    "migrants_per_island": 1,
    "checkpoint_interval": 1
  },
  "explorer": {
    "enabled": false
  },
  "conjecture": {
    "enabled": true,
    "interval": 1,
    "observations_per_interval": 8,
    "conjectures_per_interval": 2,
    "context_candidates": 8,
    "context_conjectures": 8,
    "counterexample_trials": 2,
    "min_evidence": 2,
    "timeout_seconds": 10
  },
  "metadata": {
    "purpose": "v0.5 proof planner/prover/verifier protocol smoke test",
    "proof_assumptions": [
      "For every evaluated numeric candidate x, distance_to_42 is defined as abs(x - 42)."
    ]
  }
}
