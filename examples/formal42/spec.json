{
  "name": "formal-42-demo",
  "problem": "Search near x=42, form and verify a natural-language conjecture, then compile an exact Lean theorem for the supported claim.",
  "domain": "generic",
  "mode": "hybrid",
  "objectives": [
    {"name": "distance_to_42", "direction": "minimize", "weight": 1.0}
  ],
  "constraints": [],
  "behavior_dimensions": ["representation"],
  "budget": {
    "generations": 1,
    "population_size": 1,
    "evaluator_timeout_seconds": 10,
    "seed": 11
  },
  "search": {
    "novelty_probability": 0.25,
    "novelty_k": 3,
    "migration_interval": 2,
    "migrants_per_island": 1,
    "checkpoint_interval": 1
  },
  "explorer": {"enabled": false},
  "conjecture": {
    "enabled": true,
    "interval": 1,
    "observations_per_interval": 8,
    "conjectures_per_interval": 2,
    "context_candidates": 8,
    "context_conjectures": 8,
    "counterexample_trials": 2,
    "min_evidence": 2,
    "timeout_seconds": 10
  },
  "metadata": {
    "purpose": "v0.6 Lean kernel and proof-repair smoke test",
    "proof_assumptions": [
      "For every evaluated numeric candidate x, distance_to_42 is defined as abs(x - 42)."
    ],
    "formal_contracts": [
      {
        "conjecture_statement": "Distance to 42 is always non-negative for evaluated candidates.",
        "conjecture_predicate": {
          "left": {"source": "metrics", "key": "distance_to_42"},
          "operator": "ge",
          "right_constant": 0
        },
        "backend": "lean4",
        "toolchain": "leanprover/lean4:v4.30.0",
        "theorem_name": "distance_to_42_nonnegative",
        "theorem_signature": "theorem distance_to_42_nonnegative (x : Int) : 0 ≤ Int.natAbs (x - 42)",
        "imports": [],
        "preamble": "",
        "metadata": {
          "semantic_mapping": "The v0.4 metric predicate metrics.distance_to_42 >= 0 is represented for integer x by the Lean theorem 0 ≤ Int.natAbs (x - 42)."
        }
      }
    ]
  }
}
